generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  plan      String?  // "vendas" | "gestao" | "completo" | null (sem assinatura ainda)
  createdAt DateTime @default(now())

  users         User[]
  invites       Invite[]
  leads         Lead[]
  goals         Goal[]
  coachResults  CoachResult[]
  gestaoUploads GestaoUpload[]
  revenueGoals  RevenueGoal[]
  creditAnalyses CreditAnalysis[]
  subscriptions Subscription[]
  payments      Payment[]
  supportThreads SupportThread[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  role           String       @default("master") // "master" | "member"
  createdAt      DateTime     @default(now())

  assignedLeads Lead[]
  goals         Goal[]
  leadNotes     LeadNote[]
  creditAnalyses CreditAnalysis[]
  supportThreads SupportThread[]

  @@index([organizationId])
}

model Invite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  token          String       @unique
  status         String       @default("pending") // "pending" | "accepted"
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([organizationId])
}

model CoachResult {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment        String   // "b2b" | "varejo"
  dimProcesso    Float
  dimPreco       Float
  dimTime        Float
  dimPipeline    Float
  final          Int
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  name           String
  value          Float        @default(0)
  categoria      String?
  stage          String       @default("Novo Lead")
  lostReason     String?
  expectedCloseDate DateTime?
  margemReal     Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notes LeadNote[]
  invoiceEvents InvoiceEvent[]

  @@index([organizationId])
  @@index([assignedUserId])
}

model InvoiceEvent {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Goal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  target         Float        @default(0)
  month          String // "2026-08"

  @@unique([userId, month])
  @@index([organizationId])
}

model GestaoUpload {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  rows           Json
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model RevenueGoal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String
  target         Float        @default(0)

  @@unique([organizationId, month])
  @@index([organizationId])
}

model CreditAnalysis {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  cnpj         String
  companyName  String?
  situacao     String?
  dataAbertura DateTime?
  atividade    String?

  hasFinancials     Boolean @default(false)
  receita           Float?
  lucroLiquido      Float?
  ativoCirculante   Float?
  passivoCirculante Float?
  ativoTotal        Float?
  passivoTotal      Float?

  status         String? // "aprovado" | "reprovado"
  limiteSugerido Float?
  motivoRecusa   String?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Subscription {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module               String   // "vendas" | "gestao" | "completo"
  status               String   // "active" | "canceled" | "past_due"
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())

  @@index([organizationId])
}

model Payment {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            String   // "coach_report"
  amountCents     Int
  stripePaymentId String?  @unique
  status          String   // "paid" | "pending"
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model SupportThread {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String       @default("bot") // "bot" | "escalated" | "resolved"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages ChatMessage[]

  @@index([organizationId])
  @@index([userId])
}

model ChatMessage {
  id        String        @id @default(uuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "support"
  content   String
  createdAt DateTime @default(now())

  @@index([threadId])
}

