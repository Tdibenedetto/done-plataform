generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  plan      String?  // "vendas" | "gestao" | "completo" | null (sem assinatura ainda)
  whatsappNumber String? @unique // número de WhatsApp Business (E.164, sem prefixo "whatsapp:") desta organização, usado para captação automática de leads. Atribuído manualmente pelo Admin Geral após provisionar o número no Twilio.
  followUpDays Int   @default(3) // dias sem atualização até disparar lembrete automático
  followUpError   String?   // última falha ao enviar lembrete automático (ex: Twilio sem perfil de conformidade aprovado) — limpa no próximo envio bem-sucedido
  followUpErrorAt DateTime?
  lastWeeklyReportAt DateTime? // controla o envio do relatório semanal por e-mail (1x por semana)
  createdAt DateTime @default(now())

  users         User[]
  invites       Invite[]
  leads         Lead[]
  clientes      Cliente[]
  gruposEconomicos GrupoEconomico[]
  produtos      Produto[]
  logoUrl       String?   // link colado pelo usuário — aparece na tabela de preços pública no lugar da marca D.O.N.E
  tabelaPublica TabelaPrecoPublica?
  goals         Goal[]
  coachResults  CoachResult[]
  gestaoUploads GestaoUpload[]
  revenueGoals  RevenueGoal[]
  creditAnalyses CreditAnalysis[]
  subscriptions Subscription[]
  payments      Payment[]
  supportThreads SupportThread[]
  followUpAlerts FollowUpAlert[]
  dreEntries     DreEntry[]
  dreSaldoInicial Float @default(0) // saldo de caixa inicial, usado como base do fluxo de caixa acumulado
  // Cliente no Stripe — gravado no primeiro pagamento e reaproveitado nos seguintes, para que todas
  // as assinaturas da empresa fiquem no MESMO cliente (um portal só para cancelar/trocar cartão).
  stripeCustomerId String?
  creditAlerts   CreditAlert[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  role           String       @default("master") // "master" | "member"
  phone          String?      // E.164, usado nos lembretes automáticos de follow-up
  createdAt      DateTime     @default(now())
  lastLoginAt    DateTime?    // atualizado a cada login — usado para saúde de uso no painel Admin Geral
  sortimentoAbcCriterio String @default("giro") // "giro" (volume) | "faturamento" — lembrado por usuário, não por organização

  assignedLeads Lead[]
  goals         Goal[]
  leadNotes     LeadNote[]
  creditAnalyses CreditAnalysis[]
  supportThreads SupportThread[]
  passwordResets PasswordReset[]

  @@index([organizationId])
}

// Pedido de redefinição de senha ("esqueci minha senha"). Guardamos só o HASH do código que vai
// no link do e-mail — quem tiver acesso ao banco não consegue montar o link. Vale 1 hora e 1 uso.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  token          String       @unique
  status         String       @default("pending") // "pending" | "accepted"
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([organizationId])
}

model CoachResult {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment        String   // "b2b" | "varejo"
  dimProcesso    Float
  dimPreco       Float
  dimTime        Float
  dimPipeline    Float
  final          Int
  answers          Json?    // respostas brutas por dimensão, para gerar a análise detalhada com contexto real
  detailedAnalysis Json?    // análise gerada por IA (cacheada — não regenera a cada visualização)
  trackProgress  Json?    @default("{}") // checklist da trilha de ação: { "processo-0": true, ... }
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  clienteId      String?      // vínculo opcional com o Cliente (Gestão de Crédito) — nulo em leads antigos, sem CNPJ associado ainda
  cliente        Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  name           String
  phone          String?      // telefone de contato — preenchido manualmente ou automaticamente (captação via WhatsApp)
  source         String       @default("manual") // "manual" | "whatsapp" — de onde este lead veio
  value          Float        @default(0)
  categoria      String?
  stage          String       @default("Novo Lead")
  lostReason     String?
  expectedCloseDate DateTime?
  margemReal     Float?
  fechadoEm      DateTime?    // quando entrou em Fechado — define a ordem da fila de alocação de estoque
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notes LeadNote[]
  invoiceEvents InvoiceEvent[]
  items LeadItem[]

  @@index([organizationId])
  @@index([assignedUserId])
  @@index([clienteId])
}

// Produtos do pedido de um lead. A alocação de estoque NÃO é um número guardado: ela é calculada
// na hora a partir dos itens ainda não baixados de leads em "Fechado" ou "Carteira" (ver
// lib/estoque.js). Por isso, apagar o lead, marcar como perdido ou voltar de etapa devolve o
// estoque sem nenhum ajuste. A baixa definitiva (Produto.estoqueAtual diminui) só acontece em
// "Faturado Total" — aí baixadoEm e quantidadeBaixada são preenchidos.
model LeadItem {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  quantidade Float
  baixadoEm  DateTime?
  quantidadeBaixada Float? // quanto saiu de fato do estoque na baixa (só a parte alocada)
  createdAt  DateTime @default(now())

  @@unique([leadId, produtoId])
  @@index([leadId])
  @@index([produtoId])
}

model InvoiceEvent {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Goal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  target         Float        @default(0)
  month          String // "2026-08"

  @@unique([userId, month])
  @@index([organizationId])
}

// Gestão de Sortimento. Preço e margem seguem o mesmo padrão da Análise de Crédito: o sistema
// calcula, mas os campos "*Manual" permitem o usuário sobrescrever quando quiser um valor
// diferente do calculado a partir de CMV/preço/desconto.
model Produto {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  produto        String
  sku            String
  categoria      String?
  marca          String?
  subcategoria   String?
  status         String   @default("ativo") // "ativo" | "pausado" | "descontinuado"
  fotoUrl        String?  // link colado pelo usuário — sem upload de arquivo nesta versão

  cmv             Float?
  precoAtacado    Float?
  precoPSV        Float?  // Preço Sugerido de Venda (consumidor final)
  descontoAtacado Float?  // percentual, 0-100
  descontoPSV     Float?  // percentual, 0-100

  // Sobrescreve o cálculo automático (preço, CMV, desconto) quando preenchido.
  margemAtacadoManual         Float?
  margemAtacadoDescontoManual Float?
  margemPSVManual             Float?
  margemPSVDescontoManual     Float?

  // Giro em UNIDADES — não vem de Gestão (que só guarda valor em R$, sem unidade); é próprio
  // do Sortimento, preenchido manualmente ou pela planilha deste módulo.
  estoqueAtual    Float @default(0)
  giroMedioMensal Float?

  // Compra/produção futura — soma ao estoque projetado para efeito de cobertura. Sempre que
  // preenchida, a tela exige um mês de chegada (dia 1 daquele mês, escolhido em dropdown).
  compraProducao Float?
  dataChegada    DateTime?

  coberturaIdealDias Int? // editável por produto (não por categoria/marca)

  // Dimensões e embalagem — cm e kg, livre (não validamos unidade, é o padrão que a empresa usa)
  altura       Float?
  largura      Float?
  comprimento  Float?
  pesoGross    Float?
  pesoNet      Float?
  caixaMaster  Int?    // unidades por caixa master
  tipoEmbalagem String? // Adesivo | Blister | Brownbox | Cinta | Giftbox | Tag
  ncm          String?

  origemCadastro String @default("manual") // "manual" | "planilha"

  leadItems LeadItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
}

// Link público (sem login) da tabela de preços. Uma organização tem no máximo um token ativo
// por vez — "gerar novo link" apaga o registro antigo e cria outro, invalidando o anterior na
// hora (decisão do usuário: quer poder revogar, não um link fixo pra sempre).
model TabelaPrecoPublica {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // O link fica /tabela/:slug/:token — slug é só estético (nome da empresa, pode ficar
  // desatualizado se a empresa for renomeada depois, sem problema) e token é o que realmente
  // identifica e autoriza o acesso (único, curto o bastante pra URL ficar legível).
  slug           String?
  token          String       @unique
  createdAt      DateTime     @default(now())
}

model GestaoUpload {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  rows           Json
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model RevenueGoal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String
  target         Float        @default(0)

  @@unique([organizationId, month])
  @@index([organizationId])
}

model CreditAnalysis {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  clienteId      String?      // vínculo com o Cliente (Gestão de Crédito) — cada análise nova encontra ou cria o Cliente pelo CNPJ
  cliente        Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  cnpj         String
  companyName  String?
  situacao     String?
  dataAbertura DateTime?
  atividade    String?

  hasFinancials     Boolean @default(false)
  receita           Float?
  lucroLiquido      Float?
  ativoCirculante   Float?
  passivoCirculante Float?
  ativoTotal        Float?
  passivoTotal      Float?

  status         String? // "aprovado" | "reprovado"
  limiteSugerido Float?
  motivoRecusa   String?

  monitoring    Boolean   @default(false) // acompanhar mudanças de situação cadastral automaticamente
  lastCheckedAt DateTime?
  alerts        CreditAlert[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([clienteId])
}

// Entidade compartilhada entre Vendas e Análise de Crédito — antes, um Lead (Vendas) e uma
// CreditAnalysis (Crédito) não sabiam que eram a mesma empresa, cada um com seu "nome" solto.
// Cliente é o vínculo: um CNPJ, com histórico de negociações (Leads) e de limite de crédito.
model Cliente {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cnpj           String
  razaoSocial    String
  status         String   @default("ativo") // "ativo" | "atrasado" | "bloqueado"
  statusMotivo   String?
  creditoAprovado    Float?   // limite atual, editável — a IA sugere, o usuário aprova ou digita outro valor
  creditoSugeridoIA  Float?   // última sugestão da IA, mantida como referência mesmo após aprovação manual
  // Faturamento anterior ao uso da plataforma (preenchido manualmente, uma vez) — não soma com o
  // faturamento puxado de Vendas, que é automático a partir daqui em diante.
  faturamentoAnteriorPlataforma Float @default(0)
  // Quando o Cliente pertence a um Grupo Econômico, o limite do GRUPO manda — creditoAprovado
  // acima fica sem efeito prático. O status (bloqueio) continua sempre por CNPJ.
  grupoEconomicoId String?
  grupoEconomico   GrupoEconomico? @relation(fields: [grupoEconomicoId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads           Lead[]
  creditAnalyses  CreditAnalysis[]
  limiteHistorico LimiteHistorico[]

  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@index([grupoEconomicoId])
}

// Vários CNPJs (Clientes) no mesmo grupo — matriz, filiais, franquias. O limite de crédito é
// consolidado aqui e substitui o limite individual de cada Cliente. O grupo NÃO bloqueia
// ninguém: bloqueio é por CNPJ, de propósito; o grupo só mostra a exposição total.
model GrupoEconomico {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nome           String
  creditoAprovado Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientes        Cliente[]
  limiteHistorico GrupoLimiteHistorico[]

  @@index([organizationId])
}

model GrupoLimiteHistorico {
  id            String         @id @default(uuid())
  grupoId       String
  grupo         GrupoEconomico @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  valorAnterior Float?
  valorNovo     Float
  alteradoPor   String
  createdAt     DateTime       @default(now())

  @@index([grupoId])
}

// Trilha de auditoria de mudanças de limite — nunca sobrescreve, sempre acrescenta uma linha nova.
model LimiteHistorico {
  id            String   @id @default(uuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  valorAnterior Float?
  valorNovo     Float
  alteradoPor   String   // nome de quem alterou, ou "Sugestão IA" quando é a sugestão inicial
  createdAt     DateTime @default(now())

  @@index([clienteId])
}

model Subscription {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module               String   // "vendas" | "gestao" | "completo"
  status               String   // "active" | "canceled" | "past_due"
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime?
  canceledAt           DateTime? // preenchido quando o webhook recebe subscription.deleted — usado para calcular churn
  cancelAtPeriodEnd    Boolean  @default(false) // cliente pediu cancelamento: segue com acesso até currentPeriodEnd
  createdAt            DateTime @default(now())

  @@index([organizationId])
}

model Payment {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            String   // "coach_report"
  amountCents     Int
  stripePaymentId String?  @unique
  status          String   // "paid" | "pending"
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model SupportThread {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String       @default("bot") // "bot" | "escalated" | "resolved"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages ChatMessage[]

  @@index([organizationId])
  @@index([userId])
}

model ChatMessage {
  id        String        @id @default(uuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "support"
  content   String
  createdAt DateTime @default(now())

  @@index([threadId])
}

model FollowUpAlert {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  sentTo         String   // telefone para o qual foi enviado
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
}

model DreEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String   // "2026-08" (ano-mês, evita ambiguidade entre anos)
  type           String   // "receita" | "cmv" | "despesa" | "imposto"
  category       String
  amount         Float
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, month])
}

model CreditAlert {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditAnalysisId String
  creditAnalysis   CreditAnalysis @relation(fields: [creditAnalysisId], references: [id], onDelete: Cascade)
  cnpj             String
  companyName      String?
  previousSituacao String?
  newSituacao      String?
  createdAt        DateTime      @default(now())

  @@index([organizationId])
  @@index([creditAnalysisId])
}

